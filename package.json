{
  "name": "@hyas/doks",
  "description": "Doks theme",
  "version": "0.3.4",
  "browserslist": [
    "defaults"
  ],
  "repository": "https://github.com/h-enk/doks",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "init": "shx rm -rf .git && git init -b main",
    "create": "exec-bin node_modules/.bin/hugo/hugo new",
    "prestart": "npm run clean",
    "start": "exec-bin node_modules/.bin/hugo/hugo server --bind=0.0.0.0 --disableFastRender",
    "prebuild": "npm run clean",
    "build": "exec-bin node_modules/.bin/hugo/hugo --gc --minify",
    "build:preview": "npm run build -D -F",
    "vercel:config": "node scripts/generate-vercel-config.js",
    "clean": "shx rm -rf public resources",
    "clean:install": "shx rm -rf package-lock.json node_modules ",
    "lint": "npm run -s lint:scripts && npm run -s lint:styles && npm run -s lint:markdown",
    "lint:scripts": "eslint assets/js config functions",
    "lint:styles": "stylelint \"assets/scss/**/*.{css,sass,scss,sss,less}\"",
    "lint:markdown": "markdownlint \"*.md\" \"content/**/*.md\"",
    "server": "exec-bin node_modules/.bin/hugo/hugo server",
    "test": "npm run -s lint",
    "env": "env",
    "precheck": "npm version",
    "check": "exec-bin node_modules/.bin/hugo/hugo version",
    "postinstall": "node scripts/install-hugo.js",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "test:installer": "node --test scripts/install-hugo.test.js",
    "test:tooling": "node --test scripts/install-hugo.test.js scripts/style-safelist.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fullhuman/postcss-purgecss": "^8.0.0",
    "@stylistic/stylelint-config": "^5.0.0",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "auto-changelog": "^2.3.0",
    "autoprefixer": "^10.6.2",
    "bootstrap": "^5.1",
    "clipboard": "^2.0",
    "eslint": "^10.13.0",
    "exec-bin": "^1.0.0",
    "flexsearch": "^0.7.21",
    "globals": "^17.13.0",
    "highlight.js": "^11.2",
    "lazysizes": "^5.3",
    "markdownlint-cli": "^0.50.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^12.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.7",
    "shx": "^0.4.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "otherDependencies": {
    "hugo": "0.88.1"
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.18.10"
    }
  }
}
